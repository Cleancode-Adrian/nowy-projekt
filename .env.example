APP_NAME="Projekciarz.pl"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://projekciarz.pl

APP_LOCALE=pl
APP_FALLBACK_LOCALE=pl
APP_FAKER_LOCALE=pl_PL
APP_TIMEZONE=Europe/Warsaw

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# --- Baza danych ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=projekciarz
DB_USERNAME=projekciarz_user
DB_PASSWORD=

# --- Sesja ---
# SESSION_SECURE_COOKIE=true wymaga HTTPS - na produkcji zostaw włączone.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# --- Poczta ---
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@projekciarz.pl"
MAIL_FROM_NAME="Projekciarz.pl"

# --- Bezpieczeństwo ---
# reCAPTCHA v3. Poza local/testing pusty sekret = logowanie i rejestracja
# są blokowane. Te pola MUSZĄ być wypełnione na produkcji.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_EXPECTED_HOSTNAME=projekciarz.pl
RECAPTCHA_MIN_SCORE_LOGIN=0.7
RECAPTCHA_MIN_SCORE_REGISTER=0.6
RECAPTCHA_MIN_SCORE_ADMIN_LOGIN=0.8

# Content-Security-Policy. Jeśli po wdrożeniu coś przestanie się ładować,
# ustaw SECURITY_CSP_REPORT_ONLY=true, sprawdź konsolę przeglądarki
# i dopisz brakujący host w config/security.php.
SECURITY_CSP_ENABLED=true
SECURITY_CSP_REPORT_ONLY=false

# Wymuszenie potwierdzenia adresu e-mail. Włącz DOPIERO po backfillu
# kolumny users.email_verified_at - inaczej odetniesz obecnych użytkowników.
REQUIRE_EMAIL_VERIFICATION=false

# Adresy reverse proxy (nginx). Bez tego HTTPS i realne IP nie są wykrywane.
TRUSTED_PROXIES=127.0.0.1,::1

# --- Konto administratora dla `php artisan db:seed` ---
# Puste ADMIN_PASSWORD = seeder wygeneruje losowe hasło i wypisze je raz w konsoli.
ADMIN_NAME=Administrator
ADMIN_EMAIL=
ADMIN_PASSWORD=

VITE_APP_NAME="${APP_NAME}"
